# Enable GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript
</IfModule>

# Cache Control Headers for better browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Cache images for 1 year
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jfif "access plus 1 year"
  
  # Cache CSS and JavaScript for 30 days
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  
  # Cache fonts for 1 year
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/eot "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  
  # Default cache: 2 hours
  ExpiresDefault "access plus 2 hours"
</IfModule>

# Alternative cache headers if mod_expires is not available
<IfModule mod_headers.c>
  # Cache images for 1 year
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|jfif)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  
  # Cache CSS and JS for 30 days
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
  
  # Cache fonts for 1 year
  <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  
  # HTML: Cache for 2 hours
  <FilesMatch "\.html?$">
    Header set Cache-Control "max-age=7200, must-revalidate"
  </FilesMatch>
</IfModule>

# Enable Keep-Alive for better connection handling
<IfModule mod_headers.c>
  Header set Connection "Keep-Alive"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  
  # Clickjacking protection
  Header set X-Frame-Options "SAMEORIGIN"
  
  # XSS protection
  Header set X-XSS-Protection "1; mode=block"
  
  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
